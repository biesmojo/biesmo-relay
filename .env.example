# Relay Environment Variables
# Copy to .env and fill with your Supabase/Claude credentials

# Supabase Postgres (free tier)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=postgres

# Anthropic Claude (Sonnet 4)
ANTHROPIC_API_KEY=sk-ant-...

# Hardcoded admin auth (no framework)
ADMIN_TOKEN=relay-admin-2024-change-this

# Phase 4: Email delivery (optional)
RESEND_API_KEY=re_...
